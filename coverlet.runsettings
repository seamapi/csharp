<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Like the other Seam SDKs, the tests cover SDK behavior rather than generated
               code, so measuring coverage on it would only create pressure to test the
               generator. -->
          <ExcludeByFile>**/src/Seam/Routes/**/*.cs,**/src/Seam/Models/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
