{
  "name": "@seamapi/csharp",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "version": "tsx src/version.ts",
    "postversion": "git push --follow-tags",
    "generate": "tsx codegen/smith.ts",
    "postgenerate": "tsx src/postgenerate.ts",
    "generate:csproj": "tsx src/generate-csproj.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "preformat": "eslint --fix ."
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || ^22.11.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0 || ^10.9.4"
    }
  },
  "devDependencies": {
    "@seamapi/blueprint": "^1.8.0",
    "@seamapi/smith": "^1.1.0",
    "@seamapi/types": "^1.1026.0",
    "change-case": "^5.4.4",
    "execa": "^10.0.1",
    "prettier": "^3.0.0"
  }
}
