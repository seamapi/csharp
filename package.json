{
  "name": "@seamapi/csharp",
  "version": "0.99.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "version": "tsx src/version.ts",
    "postversion": "git push --follow-tags",
    "generate": "tsx codegen/smith.ts",
    "postgenerate": "tsx src/postgenerate.ts",
    "generate:csproj": "tsx src/generate-csproj.ts",
    "build": "dotnet pack --configuration Release --output pkg ./output/csharp/src/Seam",
    "test": "dotnet test ./output/csharp",
    "test:node": "c8 ava",
    "test:update": "ava --update-snapshots",
    "test:watch": "ava --watch",
    "test:debug": "ava debug --break",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "lint:csharp": "dotnet csharpier --check ./output/csharp",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "preformat": "eslint --fix .",
    "format:csharp": "dotnet csharpier ./output/csharp",
    "typecheck": "tsc",
    "report": "c8 report"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || ^22.11.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0 || ^10.9.4"
    }
  },
  "devDependencies": {
    "@seamapi/blueprint": "^1.0.0",
    "@seamapi/smith": "^1.1.0",
    "@seamapi/types": "1.975.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "change-case": "^5.4.4",
    "execa": "^10.0.1",
    "prettier": "^3.0.0"
  }
}
