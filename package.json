{
  "name": "@seamapi/csharp",
  "version": "2.5.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "fake-seam-connect --seed",
    "version": "tsx ./version.ts",
    "postversion": "git push --follow-tags",
    "generate": "tsx codegen/smith.ts",
    "postgenerate": "just format",
    "typecheck": "tsc",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "preformat": "eslint --fix ."
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || ^22.11.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0 || ^10.9.4"
    }
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@seamapi/blueprint": "^1.13.4",
    "@seamapi/fake-seam-connect": "2.0.9",
    "@seamapi/smith": "^1.2.1",
    "@seamapi/types": "1.1209.2",
    "change-case": "^5.4.4",
    "del": "^8.0.0",
    "execa": "^10.0.1",
    "prettier": "^3.0.0"
  },
  "overrides": {
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=4": "5.0.12",
    "glob@>=9": "14.0.6",
    "handlebars": "4.7.10",
    "js-yaml@^3": "3.15.2",
    "js-yaml@^4": "4.3.2",
    "minimatch@>=7": "11.0.8"
  }
}
